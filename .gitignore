# Directories that Ren'Py changes files in.
/game/saves
/game/cache
**/__pycache__/

# Compiled script files. These are important for saving, and so should
# be preserved by developer and build systems after the game has been released.
/game/**/*.rpyc
/game/**/*.rpymc
**/*.pyc
/game/bytecode.rpyb

# Files Ren'Py can generate.
/game/**/*.bak
/game/**/*.new
/game/**/*.old

# Error, log, and output files.
/errors.txt
/files.txt
/image_cache.txt
/log.txt
/save_dump.txt
/traceback.txt

# Launcher-generated files.
/dialogue.tab
/dialogue.txt
/strings.json

# Local editor and Superpowers runtime state.
/.vscode
/.superpowers

# Ren'Py distribution output.
/ReMemorial-*-dists
